NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Server-only authentication. Use NobleNest database only. Never NEXT_PUBLIC_ secrets.
MONGODB_URI=
MONGODB_DB_NAME=noblenest
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
AUTH_JWT_AUDIENCE=http://127.0.0.1:5001
# Optional legitimate Google OAuth credentials; callback /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
